# Скопируйте в .env: cp .env.example .env
# Bun подхватывает .env автоматически.

# Подключение к PostgreSQL. Обязательно, значения по умолчанию нет.
# Формат: postgres://пользователь:пароль@хост:порт/база
DATABASE_URL=postgres://postgres:dev@localhost:5433/postgres

# Секрет для подписи JWT (админ 12 ч, посетитель 30 дней). Обязательно:
# без него сервер не стартует. Используйте длинную случайную строку,
# например: openssl rand -hex 32
JWT_SECRET=

# Origins, которым разрешён CORS: сайты с виджетом и админка, через запятую,
# без завершающего "/". Необязательно.
# По умолчанию: http://localhost:5173,http://localhost:8080
# На проде добавьте домен сайта и домен админки, например:
# ALLOWED_ORIGINS=https://vizaje-nica.com,https://admin.vizaje-nica.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Порт HTTP/WS сервера. Необязательно, по умолчанию 3001.
PORT=3001

# true, если API стоит за reverse proxy (nginx и т.п.), который выставляет
# X-Forwarded-For: тогда rate-limit считает IP клиента из этого заголовка.
# Необязательно, по умолчанию false. Не включайте без прокси: заголовок
# можно подделать и обойти лимиты.
TRUST_PROXY=false

# Папка на диске для загруженных в чат картинок. Необязательно,
# по умолчанию ./uploads (создаётся сам при первой загрузке).
UPLOAD_DIR=./uploads

# Максимальный размер одного файла, байт. Необязательно, по умолчанию
# 10485760 (10MB).
MAX_UPLOAD_SIZE=10485760

# Сколько дней хранить вложение, прежде чем удалить (файл с диска —
# само сообщение в истории остаётся). Необязательно, по умолчанию 3.
ATTACHMENT_RETENTION_DAYS=3

# Публичный адрес этого же API (без слэша в конце). Необязательно — без
# него всё работает, кроме одного: ответ оператора с картинкой в
# Telegram-беседу дублируется только текстом, без самой картинки (Bot API
# сам скачивает фото по ссылке, относительный /uploads/... для sendPhoto
# не подходит). На проде — https://chat.vizaje-nica.com
PUBLIC_API_URL=

# Web Push — уведомления в браузер админки (на телефоне работают даже при
# закрытой вкладке, как у приложения). Необязательно — без пары ключей просто
# не работает, остальное (WS, Expo push в мобильное приложение) не затронуто.
# Сгенерировать один раз: bunx web-push generate-vapid-keys — и сохранить
# навсегда (замена ключей сбросит все текущие подписки операторов)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт в заголовке запроса к push-серверу (требование спецификации Web
# Push) — mailto: или https-адрес сайта, не привязан к конкретному оператору.
# Необязательно, по умолчанию mailto:support@vizaje-nica.com
VAPID_SUBJECT=
