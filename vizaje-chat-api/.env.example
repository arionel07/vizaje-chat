# Скопируйте в .env: cp .env.example .env
# Bun подхватывает .env автоматически.

# Подключение к PostgreSQL. Обязательно, значения по умолчанию нет.
# Формат: postgres://пользователь:пароль@хост:порт/база
DATABASE_URL=postgres://postgres:dev@localhost:5433/postgres

# Секрет для подписи JWT (админ 12 ч, посетитель 30 дней). Обязательно:
# без него сервер не стартует. Используйте длинную случайную строку,
# например: openssl rand -hex 32
JWT_SECRET=

# Origins, которым разрешён CORS: сайты с виджетом и админка, через запятую,
# без завершающего "/". Необязательно.
# По умолчанию: http://localhost:5173,http://localhost:8080
# На проде добавьте домен сайта и домен админки, например:
# ALLOWED_ORIGINS=https://vizaje-nica.com,https://admin.vizaje-nica.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Порт HTTP/WS сервера. Необязательно, по умолчанию 3001.
PORT=3001

# true, если API стоит за reverse proxy (nginx и т.п.), который выставляет
# X-Forwarded-For: тогда rate-limit считает IP клиента из этого заголовка.
# Необязательно, по умолчанию false. Не включайте без прокси: заголовок
# можно подделать и обойти лимиты.
TRUST_PROXY=false
