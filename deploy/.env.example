# Скопировать в ../.env (рядом с docker-compose.yml) и заполнить.
# Не коммитить реальный .env в git.

DB_PASSWORD=
JWT_SECRET=
# Через запятую, без пробелов и без слэша в конце:
ALLOWED_ORIGINS=https://vizaje-nica.com,https://www.vizaje-nica.com,https://admin.vizaje-nica.com
ADMIN_API_URL=https://chat.vizaje-nica.com

# Необязательно — без них /telegram/webhook просто не используется.
# Токен от @BotFather; секрет — что угодно случайное (см. deploy/DEPLOY.md,
# раздел Telegram, как зарегистрировать вебхук с этим же секретом)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Необязательно — без них уведомления в браузер админки (на телефоне — как
# у приложения, даже при закрытой вкладке) просто не работают. Сгенерировать
# один раз на сервере: docker compose run --rm api bunx web-push generate-vapid-keys
# — и сохранить сюда навсегда (замена ключей сбросит все текущие подписки
# операторов, им придётся заново разрешить уведомления)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Необязательно — без них /instagram/webhook просто не используется.
# APP_SECRET — из настроек Meta-приложения (подписывает каждый вебхук-запрос).
# PAGE_ACCESS_TOKEN — от Facebook-страницы, связанной с Instagram-аккаунтом
# (нужен, чтобы отправлять ответы, не только принимать). VERIFY_TOKEN — любая
# случайная строка, см. deploy/DEPLOY.md, раздел Instagram, как подключить вебхук
INSTAGRAM_APP_SECRET=
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=
